# GET Solar Energy - Backend Environment Configuration Example
# Copy this file to .env and fill in the values.

# Database URL (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/db_name

# Dual AI Provider Configuration (Default: auto; Priority: openai,gemini; Fallback: true)
AI_PROVIDER=auto
AI_PROVIDER_PRIORITY=openai,gemini
AI_ALLOW_PROVIDER_FALLBACK=true

# Google Gemini Configuration (Fallback Provider)
GEMINI_API_KEY=
ASSISTANT_MODEL=gemini-2.5-flash-lite

# OpenAI Provider Configuration (Official Model: GPT-5.6 Luna)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=30.0

# Legacy compatibility aliases (supported, mapped internally to OPENAI_*)
# LUNA_API_KEY=
# LUNA_API_BASE=https://api.openai.com/v1
# LUNA_MODEL=gpt-5.6-luna

# JWT Configuration
JWT_SECRET_KEY=generate_a_random_32_character_string_here
JWT_ALGORITHM=HS256
RESET_TOKEN_EXPIRE_MINUTES=30

# SMTP Configuration (TLS / SSL)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=GET Solar Support <your_email@gmail.com>

# Frontend URL (used in password reset emails)
FRONTEND_URL=http://localhost:8080

# CORS allowed origins (comma-separated, or * for all)
CORS_ORIGINS=*

# Cookie Configuration (optional)
# COOKIE_DOMAIN=       # Leave blank for localhost; e.g. .getsolarenergy.in in production
# COOKIE_SECURE=false  # Set to true in production over HTTPS
# COOKIE_SAMESITE=lax

# OAuth 2.0 / OpenID Connect (Customer Authentication)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback/google

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:5173/auth/callback/microsoft
